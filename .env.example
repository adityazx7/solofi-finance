# SoloFi Fintech Prototype Environment Variables

# NextAuth / Auth.js Secret (required in production, fallback provided in dev)
AUTH_SECRET=solofi_super_secret_session_key_2025_fintech_production

# Canonical App URL
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SQLite Database File (managed by Drizzle ORM + @libsql/client)
DATABASE_URL=file:solofi.db

# Mock BaaS Configuration
MOCK_BAAS_ENABLED=true
MOCK_BAAS_PARTNER=Lead Bank Member FDIC
MOCK_BAAS_ROUTING=122000496
